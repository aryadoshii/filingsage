ENV=dev

# --- Localhost stack (Technical Decisions #30) -------------------------------
# These URLs are HOST-facing: they're what `python -m filingsage.cli` and
# pytest use when run on your machine against the ports docker-compose
# publishes. Inside containers, docker-compose.yml overrides all three with the
# in-network service names (postgres / redis / qdrant) — `localhost` inside a
# container is the container itself.
POSTGRES_USER=filingsage
POSTGRES_PASSWORD=filingsage
POSTGRES_DB=filingsage
# +psycopg selects the psycopg 3 driver this project installs; a bare
# postgresql:// makes SQLAlchemy look for psycopg2, which isn't installed.
DATABASE_URL=postgresql+psycopg://filingsage:filingsage@localhost:5432/filingsage

REDIS_URL=redis://localhost:6379/0

# Local Qdrant (compose service) — no API key; leave QDRANT_API_KEY empty.
# Only a managed Qdrant Cloud cluster needs a key (see .env.prod.example).
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# REQUIRED before any EDGAR ingestion runs — SEC fair-access policy.
SEC_CONTACT_EMAIL=you@example.com

# Scheduled ingestion (Celery beat, every 2h): newest N filings per ticker a
# scheduled run considers. New filings are always caught; this only bounds
# how far back the first run reaches.
INGEST_LIMIT_PER_TICKER=20

# Shared secret for POST /internal/ingest — used by the dashboard's "Track a
# company" form (passed to the ui container only, never to the browser) and
# by the GitHub Actions workflow if a hosted deployment ever comes back.
# Generate a real value with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave unset in any environment that shouldn't accept ingest triggers — an
# empty value makes the endpoint return 503, never open access.
INGEST_TOKEN=

# Cited Q&A (gold/qa.py). Groq is primary (console.groq.com — free tier),
# Gemini Flash is the fallback (aistudio.google.com — free tier). Leaving
# either unset just means that provider's calls fail and the other one (or
# the insufficient-evidence path) takes over — not a hard requirement to
# set both to run anything else in this app.
GROQ_API_KEY=
GEMINI_API_KEY=
