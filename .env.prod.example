# Production env file, consumed via deploy/api/fly.toml / deploy/worker/fly.toml
# `fly secrets set` (see deploy/README-fly.md) — not docker-compose.prod.yml,
# which was the pre-Fly Oracle VM plan (README → Technical Decisions #21).
# Copy to .env.prod locally only as a scratch reference when composing the
# `fly secrets set` command; .env.prod itself is gitignored and must never
# be committed.

ENV=prod

# Neon Postgres connection string. sslmode=require is mandatory — Neon
# rejects unencrypted connections, and this must use the psycopg driver
# (postgresql+psycopg://, matching Settings.database_url) not plain
# postgresql://.
DATABASE_URL=postgresql+psycopg://user:password@ep-example-12345.us-east-2.aws.neon.tech/filingsage?sslmode=require

# Upstash Redis connection string. Must use the rediss:// (TLS) scheme —
# Upstash requires TLS; plain redis:// will fail to connect. The
# ?ssl_cert_reqs=CERT_REQUIRED query param is also mandatory for Celery's
# redis transport specifically — omitting it caused a real earlier
# connection-failure incident (kombu's redis transport wants this spelled
# out explicitly for rediss:// URLs rather than assuming a default).
REDIS_URL=rediss://default:password@example-12345.upstash.io:6379?ssl_cert_reqs=CERT_REQUIRED

# REQUIRED before any EDGAR ingestion runs — SEC fair-access policy.
SEC_CONTACT_EMAIL=doshiarya27@gmail.com

# Shared secret for POST /internal/ingest, called by .github/workflows/ingest-cron.yml.
# Generate a FRESH value for prod — never reuse the dev .env's token:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
INGEST_TOKEN=

# Qdrant Cloud cluster (gold-layer hybrid vector store). REST API port is
# 6333 — include it in the URL, e.g. https://xxxxxxxx.gcp.cloud.qdrant.io:6333
QDRANT_URL=
QDRANT_API_KEY=

# Cited Q&A (gold/qa.py). Groq primary, Gemini Flash fallback — generate
# fresh keys for prod, don't reuse dev's:
#   Groq:   https://console.groq.com/keys
#   Gemini: https://aistudio.google.com/apikey
GROQ_API_KEY=
GEMINI_API_KEY=
